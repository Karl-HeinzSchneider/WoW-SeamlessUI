# Suite archive: the core addon Seamless/ is the package folder (its TOC supplies the project
# ids); every feature addon is moved out next to it as a sibling folder in the zip.
# Every addon folder in the repo is listed in move-folders; an addon left out must be ignored.
package-as: Seamless

move-folders:
  Seamless/Seamless: Seamless
  Seamless/SeamlessUnitframes: SeamlessUnitframes
  Seamless/SeamlessTooltip: SeamlessTooltip
  Seamless/SeamlessChat: SeamlessChat
  Seamless/SeamlessDamageMeter: SeamlessDamageMeter
  Seamless/SeamlessUI: SeamlessUI
  Seamless/SeamlessDarkmode: SeamlessDarkmode
  Seamless/SeamlessActionBars: SeamlessActionBars
  Seamless/SeamlessCastbar: SeamlessCastbar

ignore:
  # Root tooling (the root src/ would also collide with SeamlessUnitframes/src/ when the addon is moved).
  - docs
  - screenshots
  - src
  - package.json
  - package-lock.json
  - tsconfig.json
  - stylua.toml
  # Claude Code guidance: the root one and the one in every addon.
  - CLAUDE.md
  - "*/CLAUDE.md"
  # Human-only project description; never shipped.
  - description.md
  # Any other Markdown, at any depth.
  - "*.md"
  # LuaLS annotation files; no TOC loads them.
  - SeamlessUnitframes/src/types.lua
  - Seamless/src/types.lua
  - SeamlessTooltip/src/types.lua
  - SeamlessChat/src/types.lua
  - SeamlessDamageMeter/src/types.lua
  - SeamlessUI/src/types.lua
  - SeamlessDarkmode/src/types.lua
  - SeamlessActionBars/src/types.lua
  - SeamlessCastbar/src/types.lua
  - Seamless/src/embed/BetterGroupLoot/vendor/src/types.lua
